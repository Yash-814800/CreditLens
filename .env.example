# Copy this file to .env and fill in real values. NEVER commit .env.
# .env is gitignored. Never paste secrets into chat/prompts.

# --- App ---
APP_ENV=development                 # development | production
LOG_LEVEL=INFO

# --- Postgres (admin/migration role) ---
POSTGRES_DB=creditlens
POSTGRES_USER=creditlens_admin
POSTGRES_PASSWORD=change-me-local-only

# --- Postgres (least-privilege app role used by the backend at runtime) ---
APP_DB_USER=creditlens_app
APP_DB_PASSWORD=change-me-local-only

# Full DSN the backend connects with (should reference APP_DB_USER/PASSWORD above)
DATABASE_URL=postgresql+asyncpg://creditlens_app:change-me-local-only@db:5432/creditlens

# --- Auth / crypto ---
# Must be >= 32 random chars in production; app refuses to start otherwise.
JWT_SECRET=change-me-to-a-random-32-plus-character-secret
JWT_EXPIRE_MINUTES=30
HMAC_PEPPER=change-me-to-a-random-32-plus-character-pepper

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_VISION_MODEL=
GEMINI_SUMMARY_MODEL=
MOCK_LLM=true                       # must be false in production; forbidden to be true when APP_ENV=production
GEMINI_MAX_CALLS_PER_RUN=20          # hard ceiling on real Gemini calls per process lifetime
EXTRACTION_SELF_CONSISTENCY=false   # extract documents twice with permuted prompts to detect instability

# --- Storage ---
STORAGE_BACKEND=local                # local | s3
S3_BUCKET=
AWS_REGION=ap-south-1

# --- API security ---
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
MAX_UPLOAD_MB=15
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_UPLOAD=10/minute
RETENTION_DAYS=90

# --- Demo ---
ENABLE_DEMO_ENDPOINTS=true
DEMO_UNDERWRITER_PASSWORD=change-me-demo-only
DEMO_AUDITOR_PASSWORD=change-me-demo-only
DEMO_ADMIN_PASSWORD=change-me-demo-only

# --- Deployment ---
SITE_ADDRESS=localhost
